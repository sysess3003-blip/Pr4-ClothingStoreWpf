<Window x:Class="ClothingStoreWpf.Views.ProductManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление товарами" Height="720" Width="1050" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <TextBlock Text="Управление каталогом" FontSize="21" FontWeight="Bold" />
            <TextBlock Text="Доступно только администратору. Удаление выполняется мягко: товар скрывается из каталога, но остаётся в истории заказов." Foreground="#657080" TextWrapping="Wrap" Margin="0,3,0,0" />
        </StackPanel>
        <DataGrid x:Name="ProductsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionChanged="ProductsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ProductID}" Width="55" />
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="2*" />
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="*" />
                <DataGridTextColumn Header="Артикул" Binding="{Binding SKU}" Width="110" />
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="90" />
                <DataGridTextColumn Header="Остаток" Binding="{Binding StockQuantity}" Width="75" />
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
        <GroupBox Grid.Row="2" Header="Карточка товара" Margin="0,10,0,8" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Grid.RowSpan="2"><TextBlock Text="Название" Margin="4,0"/><TextBox x:Name="ProductNameBox" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Категория" Margin="4,0"/><ComboBox x:Name="CategoryBox" Margin="4" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryID" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Артикул" Margin="4,0"/><TextBox x:Name="SkuBox" /></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="Размер" Margin="4,0"/><TextBox x:Name="SizeBox" /></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="Цвет" Margin="4,0"/><TextBox x:Name="ColorBox" /></StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="1"><TextBlock Text="Цена, ₽" Margin="4,0"/><TextBox x:Name="PriceBox" /></StackPanel>
                <StackPanel Grid.Column="2" Grid.Row="1"><TextBlock Text="Количество" Margin="4,0"/><TextBox x:Name="StockBox" Text="0" /></StackPanel>
                <TextBlock Grid.Column="3" Grid.Row="1" Grid.ColumnSpan="2" Text="Для добавления нажмите «Новый», затем «Сохранить». Для изменения выберите товар выше." TextWrapping="Wrap" VerticalAlignment="Center" Margin="6" Foreground="#657080" />
            </Grid>
        </GroupBox>
        <DockPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Новый" Click="New_Click" />
                <Button Content="Сохранить" Click="Save_Click" Background="{StaticResource AccentBrush}" Foreground="White" />
                <Button Content="Скрыть товар" Click="Delete_Click" />
            </StackPanel>
            <Button Content="Закрыть" DockPanel.Dock="Right" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
