<Window x:Class="ClothingStoreWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Интернет-магазин одежды" Height="760" Width="1220" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="14" CornerRadius="8" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="CLOTHING STORE" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Каталог одежды и оформление заказов" Foreground="#657080" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UserLabel" Text="Гость" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8" />
                    <Button x:Name="LoginButton" Content="Войти" Click="Login_Click" />
                    <Button x:Name="RegisterButton" Content="Регистрация" Click="Register_Click" />
                    <Button x:Name="LogoutButton" Content="Выйти" Click="Logout_Click" Visibility="Collapsed" />
                    <Button x:Name="OrdersButton" Content="Заказы" Click="Orders_Click" IsEnabled="False" />
                    <Button x:Name="ManageProductsButton" Content="Товары" Click="ManageProducts_Click" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="2,0,2,10">
                        <TextBlock Text="Каталог товаров" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Обновить" Click="RefreshProducts_Click" />
                    </DockPanel>
                    <DataGrid x:Name="ProductsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" SelectionChanged="ProductsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="2*" />
                            <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="*" />
                            <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="70" />
                            <DataGridTextColumn Header="Цвет" Binding="{Binding Color}" Width="*" />
                            <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="95" />
                            <DataGridTextColumn Header="Остаток" Binding="{Binding StockQuantity}" Width="72" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Margin="4,10,4,0" Foreground="#657080"
                               Text="Выберите товар, укажите количество и добавьте его в корзину." TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Корзина" FontSize="18" FontWeight="SemiBold" Margin="2,0,2,10" />
                    <DataGrid x:Name="CartGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="2*" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="85" />
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="65" />
                            <DataGridTextColumn Header="Сумма" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <DockPanel>
                            <TextBlock Text="Количество:" VerticalAlignment="Center" />
                            <TextBox x:Name="QuantityTextBox" Text="1" Width="55" HorizontalContentAlignment="Center" />
                            <Button Content="В корзину" Click="AddToCart_Click" />
                            <Button Content="Убрать" Click="RemoveFromCart_Click" />
                        </DockPanel>
                        <TextBlock Text="Адрес доставки" FontWeight="SemiBold" Margin="4,8,4,0" />
                        <TextBox x:Name="AddressTextBox" Text="г. Вологда, ул. Мира, д. 10" />
                        <DockPanel Margin="4,6,4,0">
                            <TextBlock x:Name="TotalLabel" Text="Итого: 0,00 ₽" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="Оформить заказ" Background="{StaticResource AccentBrush}" Foreground="White"
                                    FontWeight="SemiBold" Click="PlaceOrder_Click" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="Учебное приложение · База данных Lab3_ClothingStoreDB · SQL Server"
                   Foreground="#657080" HorizontalAlignment="Center" Margin="0,10,0,0" />
    </Grid>
</Window>
